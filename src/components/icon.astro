---
import type { IconName } from "@/data/site"

interface Props {
  name: IconName
  class?: string
  size?: number
}

const { name, class: className = "", size } = Astro.props

/**
 * Inline SVG bodies keep the page free of an icon runtime.
 *
 * Every icon is drawn on the same 24px grid with a 1.5 stroke, round caps and
 * round joins, so the set reads as one family at any size. Filled brand marks
 * are scaled down slightly so their mass matches the strokes beside them.
 */
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.5",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const

const icons: Record<IconName, { attrs: Record<string, string>; body: string }> =
  {
    "arrow-up-right": {
      attrs: stroke,
      body: '<path d="M7 17 17 7"/><path d="M8.5 7H17v8.5"/>',
    },
    "arrow-down": {
      attrs: stroke,
      body: '<path d="M12 4.75v14.5"/><path d="m6 13.5 6 6 6-6"/>',
    },
    "arrow-right": {
      attrs: stroke,
      body: '<path d="M4.75 12h14.5"/><path d="m13.5 5.75 6.25 6.25-6.25 6.25"/>',
    },
    mail: {
      attrs: stroke,
      body: '<rect x="3.25" y="5.5" width="17.5" height="13" rx="2.5"/><path d="m4 7.5 8 5.5 8-5.5"/>',
    },
    bookmark: {
      attrs: stroke,
      body: '<path d="M6.75 4.5h10.5a1.25 1.25 0 0 1 1.25 1.25v13.5L12 14.75l-6.5 4.5v-13.5A1.25 1.25 0 0 1 6.75 4.5Z"/>',
    },
    file: {
      attrs: stroke,
      body: '<path d="M13.5 3.75H7.5A1.75 1.75 0 0 0 5.75 5.5v13a1.75 1.75 0 0 0 1.75 1.75h9a1.75 1.75 0 0 0 1.75-1.75V8.25Z"/><path d="M13.5 3.75v4.5h4.5"/><path d="M9 13h6"/><path d="M9 16.25h4"/>',
    },
    linkedin: {
      attrs: stroke,
      body: '<rect x="3.25" y="3.25" width="17.5" height="17.5" rx="4.25"/><path d="M7.6 10.6v6.15"/><circle cx="7.6" cy="7.6" r="1" fill="currentColor" stroke="none"/><path d="M11.6 16.75v-6.15"/><path d="M11.6 13.05a2.5 2.5 0 0 1 5 0v3.7"/>',
    },
    github: {
      // The official mark is a filled silhouette, so it carries far more mass
      // than a 1.5 stroke. Scaling it to 86% puts it in the same weight class
      // as the icons beside it.
      attrs: { fill: "currentColor" },
      body: '<g transform="translate(12 12) scale(0.86) translate(-12 -12)"><path d="M12 1.75a10.25 10.25 0 0 0-3.24 19.98c.51.09.7-.22.7-.5v-1.74c-2.85.62-3.45-1.37-3.45-1.37-.47-1.18-1.14-1.5-1.14-1.5-.93-.63.07-.62.07-.62 1.03.07 1.57 1.06 1.57 1.06.92 1.56 2.4 1.11 2.98.85.09-.66.36-1.11.65-1.37-2.28-.26-4.68-1.14-4.68-5.06 0-1.12.4-2.03 1.05-2.75-.1-.26-.46-1.31.1-2.72 0 0 .86-.28 2.82 1.05a9.8 9.8 0 0 1 5.13 0c1.96-1.33 2.82-1.05 2.82-1.05.56 1.41.21 2.46.1 2.72.66.72 1.05 1.63 1.05 2.75 0 3.93-2.4 4.8-4.69 5.05.37.32.7.95.7 1.92v2.85c0 .28.19.6.71.5A10.25 10.25 0 0 0 12 1.75Z"/></g>',
    },
  }

const icon = icons[name]
const pixels = size ?? (name.startsWith("arrow") ? 20 : 24)
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={pixels}
  height={pixels}
  class={className}
  aria-hidden="true"
  focusable="false"
  {...icon.attrs}
  set:html={icon.body}
/>
