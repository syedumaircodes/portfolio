---
import Icon from "@/components/icon.astro"
import { site } from "@/data/site"

/**
 * The statement is broken into words so each one can rise out of its own clip
 * on load. `*word*` in the data is set in the display face's true italic.
 */

type Word = { text: string; italic: boolean }

const lines: Word[][] = site.headline.split("\n").map((line) =>
  line
    .split(/(\*[^*]+\*)/)
    .filter(Boolean)
    .flatMap((part) =>
      part
        .replace(/\*/g, "")
        .split(" ")
        .filter(Boolean)
        .map((text) => ({ text, italic: part.startsWith("*") }))
    )
)

const primaryButton =
  "group relative inline-flex h-12 items-center gap-2.5 overflow-hidden rounded-full bg-primary px-6 text-sm font-medium text-primary-foreground shadow-[0_0_0_0_color-mix(in_oklch,var(--primary)_0%,transparent)] transition-[box-shadow,transform] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:shadow-[0_0_40px_-12px_color-mix(in_oklch,var(--primary)_60%,transparent)] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"

const secondaryButton =
  "group relative inline-flex h-12 items-center gap-2.5 overflow-hidden rounded-full border border-border bg-transparent px-6 text-sm font-medium text-foreground transition-[background-color,border-color,transform] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-foreground/25 hover:bg-surface-hover active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
---

<section id="top" data-hero class="relative isolate">
  <!-- The curtain: covers the page for a beat, then lifts. -->
  <div
    data-curtain
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-50 bg-background"
  ></div>

  <!-- Atmosphere: grain, pointer bloom -->
  <div
    class="pointer-events-none absolute inset-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      data-grain
      class="grain absolute -inset-[200px] opacity-[0.05] mix-blend-overlay"
      style="animation: grain-drift 7s linear infinite alternate"
    ></div>
  </div>

  <div
    data-bloom
    aria-hidden="true"
    class="pointer-events-none fixed top-0 left-0 z-0 h-[680px] w-[680px] rounded-full bg-[radial-gradient(circle,color-mix(in_oklch,var(--foreground)_9%,transparent),transparent_62%)] blur-[100px]"
  ></div>

  <div class="relative z-10 mx-auto flex min-h-svh w-full max-w-360 flex-col px-6 sm:px-10 lg:px-16">
    <!-- Body -->
    <div class="flex flex-1 flex-col justify-center py-16 sm:py-20 lg:py-24">
      <!-- The statement -->
      <div class="relative">
        <!-- 9vw keeps the long second line ("that works in the real world.")
             on one row from the sm breakpoint up; 8rem is the display ceiling. -->
        <h1 data-title class="display text-[clamp(2.75rem,9vw,8rem)]">
          {lines.map((line, index) => (
            <>
              {index > 0 && (
                <>
                  <br class="hidden sm:inline" />{" "}
                </>
              )}
              {line.map((word, wordIndex) => (
                <>
                  <span
                    class:list={[
                      "hero-word",
                      word.italic && "hero-word--italic",
                    ]}
                    data-word
                  >
                    {word.text}
                  </span>
                  {wordIndex < line.length - 1 && " "}
                </>
              ))}{" "}
            </>
          ))}
        </h1>
      </div>

      <!-- Supporting column + index -->
      <div class="mt-10 grid gap-12 sm:mt-12 md:grid-cols-[1.25fr_0.9fr] md:items-end md:gap-16 lg:mt-14">
        <div data-support>
          <p class="max-w-176 text-base leading-[1.75] text-pretty text-muted-foreground sm:text-lg">
            {site.intro}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3 sm:mt-10">
            <a href={`mailto:${site.email}`} class={primaryButton}>
              <span class="relative z-10">Let's talk</span>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -translate-x-full bg-[linear-gradient(100deg,transparent,color-mix(in_oklch,var(--primary-foreground)_10%,transparent),transparent)] transition-transform duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-full"
              ></span>
              <Icon
                name="arrow-up-right"
                class="relative z-10 size-4.5 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
            <a href="#work" class={secondaryButton}>
              <span class="relative z-10">Explore my work</span>
              <Icon
                name="arrow-down"
                class="relative z-10 size-4.5 text-muted-foreground transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0.5 group-hover:text-foreground"
              />
            </a>
          </div>

          <ul class="mt-10 flex items-center gap-1 sm:gap-2">
            {site.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  aria-label={social.label}
                  title={social.label}
                  class="group/social relative inline-flex size-10 items-center justify-center rounded-full text-muted-foreground transition-colors duration-300 hover:bg-surface-hover hover:text-foreground"
                  {...(social.href.startsWith("http")
                    ? { target: "_blank", rel: "noreferrer noopener" }
                    : {})}
                  {...(social.download ? { download: social.download } : {})}
                >
                  <Icon name={social.icon} class="size-5" />
                  <span class="pointer-events-none absolute inset-0 rounded-full border border-foreground/20 opacity-0 transition-opacity duration-300 group-hover/social:opacity-100" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- The index -->
        <ol data-index class="flex flex-col [&>li:last-child]:border-b">
          {site.capabilities.map((capability) => (
            <li data-index-item class="border-t border-border">
              <a
                href="#work"
                class="group flex items-baseline justify-between gap-5 py-3.5 sm:py-4"
              >
                <span class="min-w-0">
                  <span class="block text-[0.9375rem] font-medium text-foreground transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1">
                    {capability.label}
                  </span>
                  <span class="mt-1 block text-xs text-muted-foreground">
                    {capability.detail}
                  </span>
                </span>
                <Icon
                  name="arrow-up-right"
                  class="size-4 shrink-0 -translate-x-1 text-muted-foreground opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0 group-hover:opacity-100"
                />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from "@/scripts/hero"
  initHero()
</script>

<style>
  /* The curtain only exists when JavaScript can lift it. */
  [data-curtain] {
    opacity: 0;
  }

  :global(html.js) [data-curtain] {
    opacity: 1;
  }

  /* Words rise out of a clip. The clip is applied in CSS so the page still
     renders without JavaScript, and released by the timeline on load. */
  .hero-word {
    display: inline-block;
    will-change: transform, clip-path;
  }

  :global(html.js) .hero-word {
    clip-path: inset(-0.25em 0 100% 0);
  }

  /* The italic word uses the display face's true italic cut. */
  .hero-word--italic {
    font-style: italic;
  }
</style>
