---
import ActionLink from "@/components/action-link.astro"
import { site } from "@/data/site"

// Normalize optional covers to a plain URL so the native <img> is happy:
// imported assets expose their resolved URL on `.src`.
const projects = site.projects.map((project) => ({
  ...project,
  coverSrc:
    typeof project.cover === "string" ? project.cover : project.cover?.src,
}))
---

<section
  id="work"
  data-work
  class="relative mx-auto w-full max-w-360 scroll-mt-24 px-6 sm:px-10 lg:px-16"
>
  <div class="pt-10 sm:pt-14">
    <!-- Section head -->
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 class="display text-[clamp(2.25rem,5vw,4rem)]">Selected work</h2>
    </div>

    <div class="mt-12 sm:mt-16 lg:mt-20">
      {projects.map((project, index) => (
        <article class="group">
          {index > 0 && (
            <span
              data-reveal="rule"
              class="block h-px w-full origin-left scale-x-0 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] mb-16 sm:mb-24"
            />
          )}

          <div
            class="relative overflow-hidden bg-secondary"
            data-reveal="media"
          >
            {project.coverSrc ? (
              <a
                href={project.live}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`Open ${project.title} in a new tab`}
                class="block"
              >
                <img
                  src={project.coverSrc}
                  alt={`Screenshot of ${project.title}`}
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/3 w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] sm:aspect-16/10 lg:aspect-16/9"
                />
              </a>
            ) : (
              <div class="flex aspect-4/3 w-full items-center justify-center sm:aspect-16/10 lg:aspect-16/9">
                <span class="display text-2xl text-muted-foreground">
                  {project.title}
                </span>
              </div>
            )}
          </div>

          {/* Details */}
          <div class="mt-8 grid gap-8 md:grid-cols-[1.05fr_0.95fr] md:gap-16 lg:mt-10">
            <div>
              <p class="meta text-muted-foreground" data-reveal="text">
                {project.category} / {project.month} {project.year}
              </p>
              <h3
                class="display mt-4 text-[clamp(2rem,3.6vw,3.25rem)]"
                data-reveal="text"
                style="--reveal-delay: 90ms"
              >
                {project.title}
              </h3>
            </div>

            <div class="md:pt-10">
              <p
                class="max-w-lg text-base leading-relaxed text-pretty text-muted-foreground"
                data-reveal="text"
                style="--reveal-delay: 180ms"
              >
                {project.description}
              </p>

              <p
                class="meta mt-6 text-muted-foreground"
                data-reveal="text"
                style="--reveal-delay: 260ms"
              >
                {project.technologies.join("  ·  ")}
              </p>

              <div
                class="mt-7 flex flex-wrap items-center gap-3"
                data-reveal="text"
                style="--reveal-delay: 340ms"
              >
                <ActionLink
                  href={project.live}
                  label="Live"
                  variant="primary"
                  icon="arrow-up-right"
                  external
                />
                <ActionLink
                  href={project.github}
                  label="Source"
                  icon="github"
                  external
                />
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
