---
import Icon from "@/components/icon.astro"
import { site } from "@/data/site"
import claudeIcon from "@/assets/icons/claude.svg"
import chatgptIcon from "@/assets/icons/chatgpt.svg"
import grokIcon from "@/assets/icons/grok.svg"

const prompt =
  "Explore%20https%3A%2F%2Fsyedumaircodes.vercel.app%2F%20and%20tell%20me%20about%20Syed%20Umair%20Ali.%20Give%20me%20a%20concise%2C%20useful%20overview%20of%20his%20background%2C%20technical%20strengths%2C%20projects%2C%20and%20the%20kinds%20of%20problems%20he%20can%20help%20solve.%20Focus%20on%20information%20that%20would%20help%20me%20understand%20whether%20his%20work%20is%20relevant%20to%20what%20I%E2%80%99m%20looking%20for."

const aiList = [
  {
    name: "ChatGPT",
    icon: chatgptIcon,
    href: `https://chatgpt.com/?q=${prompt}`,
  },
  {
    name: "Claude",
    icon: claudeIcon,
    href: `https://claude.ai/new?q=${prompt}`,
  },
  {
    name: "Grok",
    icon: grokIcon,
    href: `https://grok.com/?q=${prompt}`,
  },
]
---

<section
  id="contact"
  class="relative mx-auto w-full max-w-360 scroll-mt-24 px-6 sm:px-10 lg:px-16"
>
  <div class="py-20 sm:py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <!-- The closing statement, and the one thing to do next -->
      <div>
        <h2
          class="display text-[clamp(2.25rem,5vw,4.25rem)]"
          data-reveal="text"
        >
          Tell me what you're <em class="italic">building.</em>
        </h2>

        <p
          class="mt-7 max-w-xl text-base leading-[1.75] text-pretty text-muted-foreground sm:text-lg"
          data-reveal="text"
          style="--reveal-delay: 90ms"
        >
          I build backends, interfaces, and the infrastructure that keeps them
          running. If you have a product to ship, a workflow to untangle, or a
          role you need filled, email me.
        </p>

        <a
          href={`mailto:${site.email}`}
          class="group mt-10 inline-flex items-center gap-3 text-[clamp(1.375rem,2.4vw,1.875rem)] text-foreground"
          data-reveal="text"
          style="--reveal-delay: 180ms"
        >
          <span class="relative">
            {site.email}
            <span class="absolute -bottom-1 left-0 h-px w-full origin-right scale-x-0 bg-foreground transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:origin-left group-hover:scale-x-100"></span>
          </span>
          <Icon
            name="arrow-up-right"
            class="size-6 shrink-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 group-hover:-translate-y-1"
          />
        </a>
      </div>

      <!-- The agent-readable layer: a quiet, secondary column -->
      <div class="lg:border-l lg:border-border lg:pl-16">
        <h3 class="meta text-muted-foreground" data-reveal="text">
          Ask any AI about me
        </h3>

        <p
          class="mt-5 max-w-sm text-sm leading-relaxed text-muted-foreground"
          data-reveal="text"
          style="--reveal-delay: 90ms"
        >
          Curious about my background, skills, and work? Open a chat with the
          model you already use and let it read this site for you.
        </p>

        <nav aria-label="Ask an AI about Umair" class="mt-7 flex flex-col">
          {aiList.map((ai, index) => (
            <a
              href={ai.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ask ${ai.name} about ${site.name}`}
              class="group flex items-center gap-3 border-t border-border py-3.5 transition-colors duration-300"
              data-reveal="text"
              style={`--reveal-delay: ${140 + index * 70}ms`}
            >
              <img
                src={ai.icon.src}
                alt=""
                class="size-4.5 object-contain opacity-60 transition-opacity duration-300 group-hover:opacity-100"
              />
              <span class="text-sm text-foreground">{ai.name}</span>
              <Icon
                name="arrow-up-right"
                class="ml-auto size-4 -translate-x-1 text-muted-foreground opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0 group-hover:opacity-100"
              />
            </a>
          ))}
          <span class="block h-px w-full bg-border" />
        </nav>
      </div>
    </div>
  </div>
</section>
